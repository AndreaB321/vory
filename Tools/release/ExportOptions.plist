<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>teamID</key>
	<string>4PLALDQ8V8</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- We stamp the build number in testflight.sh, so Xcode must not rewrite it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<!-- Manual signing on purpose. Automatic signing tries Apple's cloud-managed certificates,
	     which an App Manager API key is not permitted to create ("Cloud signing permission
	     error"). The certificate and both profiles are created through the API instead. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.vorantx.vory.notifications</key>
		<string>Vory Notification Service App Store</string>
		<key>com.vorantx.vory.watchkitapp</key>
		<string>Vory Watch App Store</string>
		<key>com.vorantx.vory.watchkitapp.complications</key>
		<string>Vory Watch Complications App Store</string>
		<key>com.vorantx.vory</key>
		<string>Vory App Store</string>
		<key>com.vorantx.vory.LiveActivity</key>
		<string>Vory LiveActivity App Store</string>
	</dict>
</dict>
</plist>
